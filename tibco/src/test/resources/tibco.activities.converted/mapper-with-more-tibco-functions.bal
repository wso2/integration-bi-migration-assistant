function activityExtension(Context cx) returns error? {
    xml var0 = getFromContext(cx, "InputVariable");
    xml var1 = check xml:fromString(string `<?xml version="1.0" encoding="UTF-8"?><xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"><xsl:param name="tibcoUuid1" xmlns:tibfn="http://www.tibco.com/bw/xslt/custom-functions" tibfn:generated="uuid"/><xsl:param name="tibcoUuid2" xmlns:tibfn="http://www.tibco.com/bw/xslt/custom-functions" tibfn:generated="uuid"/><xsl:param name="Input"/><xsl:template name="Template" match="/"><result><renderedInput><xsl:value-of select="tib:render-xml($Input)"/></renderedInput><idsAndParent><xsl:value-of select="concat($tibcoUuid1, ' ', $tibcoUuid2, ' ', tib:substring-before-last($Input/path, '/'))"/></idsAndParent></result></xsl:template><xsl:function name="tibfn:render-xml" xmlns:tibfn="http://www.tibco.com/bw/xslt/custom-functions"><xsl:param name="node"/><xsl:sequence select="serialize(if ($node instance of document-node() and $node/root) then $node/root/node() else $node)"/></xsl:function><xsl:function name="tibfn:render-xml" xmlns:tibfn="http://www.tibco.com/bw/xslt/custom-functions"><xsl:param name="node"/><xsl:param name="includeDeclaration"/><xsl:sequence select="tibfn:render-xml($node, $includeDeclaration, false())"/></xsl:function><xsl:function name="tibfn:render-xml" xmlns:tibfn="http://www.tibco.com/bw/xslt/custom-functions"><xsl:param name="node"/><xsl:param name="includeDeclaration"/><xsl:param name="pretty"/><xsl:sequence select="serialize(if ($node instance of document-node() and $node/root) then $node/root/node() else $node, map{'omit-xml-declaration': not(boolean($includeDeclaration)), 'indent': boolean($pretty)})"/></xsl:function><xsl:function name="tibfn:substring-before-last" xmlns:tibfn="http://www.tibco.com/bw/xslt/custom-functions"><xsl:param name="value"/><xsl:param name="delimiter"/><xsl:choose><xsl:when test="string($delimiter) = ''"><xsl:sequence select="string($value)"/></xsl:when><xsl:otherwise><xsl:variable name="parts" select="tokenize(string($value), string($delimiter), 'q')"/><xsl:sequence select="string-join(subsequence($parts, 1, count($parts) - 1), string($delimiter))"/></xsl:otherwise></xsl:choose></xsl:function></xsl:stylesheet>`);
    xml var2 = check xslt:transform(var0, var1, xsltParams(cx.variables, {"tibcoUuid1": uuid:createType4AsString(), "tibcoUuid2": uuid:createType4AsString()}));
    xml var3 = xml`<root>${var2}</root>`;
    addToContext(cx, "OutputVariable", var3);
}
