<bpws:extensionActivity>
    <tibex:activityExtension inputVariable="ListFilesLocalResponse-input"
                             name="ListFilesLocalResponse"
                             outputVariable="ListFilesLocalResponse"
                             tibex:xpdlId="e764414d-4eab-41ea-a65f-2bb24445fada"
                             xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
        <bpws:targets>
            <bpws:target linkName="LogToListFilesLocalResponse"/>
        </bpws:targets>
        <bpws:sources>
            <bpws:source linkName="ListFilesToExistRemoteFileResponseKPI"/>
        </bpws:sources>
        <tibex:inputBindings>
            <tibex:inputBinding
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LocalWorkPath&quot;/>&lt;xsl:template name=&quot;ListFilesLocalResponse-input&quot; match=&quot;/&quot;>&lt;tns5:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;concat($LocalWorkPath, '*.csv')&quot;/>&lt;/fileName>&lt;/tns5:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
        </tibex:inputBindings>
        <tibex:config>
            <bwext:BWActivity activityTypeID="bw.file.list"
                              xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                              xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                              xmlns:file="http://ns.tibco.com/bw/palette/file"
                              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <activityConfig>
                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                        <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                        <value mode="only-files" xsi:type="file:ListFiles"/>
                    </properties>
                </activityConfig>
            </bwext:BWActivity>
        </tibex:config>
    </tibex:activityExtension>
</bpws:extensionActivity>
