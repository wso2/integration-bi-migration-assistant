<bpws:extensionActivity xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
                        xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
    <tibex:activityExtension inputVariable="ParseXml-input" name="ParseXml" outputVariable="ParseXml">
        <bpws:targets>
            <bpws:target linkName="Target"/>
        </bpws:targets>
        <bpws:sources>
            <bpws:source linkName="Source"/>
        </bpws:sources>
        <tibex:inputBindings>
            <tibex:inputBinding
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;ParseXml-input&quot; match=&quot;/&quot;>&lt;tns4:xmlString>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body&quot;/>&lt;/tns4:xmlString>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
        </tibex:inputBindings>
        <tibex:config>
            <bwext:BWActivity
                    activityTypeID="bw.xml.parsexml"
                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <activityConfig>
                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                        <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                        <value inputStyle="text" xsi:type="palettexml:ParseXml"/>
                    </properties>
                </activityConfig>
            </bwext:BWActivity>
        </tibex:config>
    </tibex:activityExtension>
</bpws:extensionActivity>
