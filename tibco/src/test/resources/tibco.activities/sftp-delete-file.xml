                             xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
        <bpws:targets>
            <bpws:target linkName="ArchiveOrderToDeleteProcessedOrder"/>
        </bpws:targets>
        <bpws:sources>
            <bpws:source linkName="DeleteProcessedOrderToEnd"/>
        </bpws:sources>
        <tibex:inputBindings>
            <tibex:inputBinding
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/activity/removeRemoteFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OutboundDir&quot;/>&lt;xsl:param name=&quot;FileName&quot;/>&lt;xsl:template name=&quot;DeleteProcessedOrder-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;RemoteDirectory>&lt;xsl:value-of select=&quot;$OutboundDir&quot;/>&lt;/RemoteDirectory>&lt;RemoteFileName>&lt;xsl:value-of select=&quot;$FileName&quot;/>&lt;/RemoteFileName>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
        </tibex:inputBindings>
        <tibex:config>
