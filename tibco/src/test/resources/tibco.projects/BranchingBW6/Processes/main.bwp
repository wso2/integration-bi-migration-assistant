<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no"
    name="test.branching.MainProcess" suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/test/branching"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"
    xmlns:tns="http://xmlns.example.com/test/branching">
    <bpws:scope name="MainScope">
        <bpws:flow name="mainFlow">
            <bpws:links>
                <bpws:link name="CheckToOk" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckToAlt" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckToFail" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="OkLogToOkDone" tibex:linkType="SUCCESS"/>
                <bpws:link name="OkDoneToJoin" tibex:linkType="SUCCESS"/>
                <bpws:link name="AltLogToJoin" tibex:linkType="SUCCESS"/>
                <bpws:link name="FailLogToFailThrow" tibex:linkType="SUCCESS"/>
                <bpws:link name="JoinToRisky" tibex:linkType="SUCCESS"/>
                <bpws:link name="RiskyToRecover" tibex:linkType="ERROR"/>
                <bpws:link name="RiskyToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
        <bpws:extensionActivity>
            <tibex:activityExtension inputVariable="Check-input" name="Check"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
            <bpws:sources>
                <bpws:source linkName="CheckToOk">
                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$mode = 'ok']]></bpws:transitionCondition>
                </bpws:source>
                <bpws:source linkName="CheckToAlt">
                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$mode = 'alt']]></bpws:transitionCondition>
                </bpws:source>
                <bpws:source linkName="CheckToFail">
                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                </bpws:source>
            </bpws:sources>
                <tibex:inputBindings>
                    <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Check-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>Check&lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.generalactivities.log" version="6.0.0.001"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                <value controlBy="Application" role="Info" suppressJobInfo="true"
                                    xsi:type="generalactivities:Log"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
        <bpws:extensionActivity>
            <tibex:activityExtension inputVariable="OkLog-input" name="OkLog"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
            <bpws:targets>
                <bpws:target linkName="CheckToOk"/>
            </bpws:targets>
            <bpws:sources>
                <bpws:source linkName="OkLogToOkDone"/>
            </bpws:sources>
                <tibex:inputBindings>
                    <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;OkLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>OkLog&lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.generalactivities.log" version="6.0.0.001"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                <value controlBy="Application" role="Info" suppressJobInfo="true"
                                    xsi:type="generalactivities:Log"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
        <bpws:extensionActivity>
            <tibex:activityExtension inputVariable="OkDone-input" name="OkDone"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
            <bpws:targets>
                <bpws:target linkName="OkLogToOkDone"/>
            </bpws:targets>
            <bpws:sources>
                <bpws:source linkName="OkDoneToJoin"/>
            </bpws:sources>
                <tibex:inputBindings>
                    <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;OkDone-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>OkDone&lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.generalactivities.log" version="6.0.0.001"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                <value controlBy="Application" role="Info" suppressJobInfo="true"
                                    xsi:type="generalactivities:Log"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
        <bpws:extensionActivity>
            <tibex:activityExtension inputVariable="AltLog-input" name="AltLog"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
            <bpws:targets>
                <bpws:target linkName="CheckToAlt"/>
            </bpws:targets>
            <bpws:sources>
                <bpws:source linkName="AltLogToJoin"/>
            </bpws:sources>
                <tibex:inputBindings>
                    <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;AltLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>AltLog&lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.generalactivities.log" version="6.0.0.001"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                <value controlBy="Application" role="Info" suppressJobInfo="true"
                                    xsi:type="generalactivities:Log"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
        <bpws:extensionActivity>
            <tibex:activityExtension inputVariable="FailLog-input" name="FailLog"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
            <bpws:targets>
                <bpws:target linkName="CheckToFail"/>
            </bpws:targets>
            <bpws:sources>
                <bpws:source linkName="FailLogToFailThrow"/>
            </bpws:sources>
                <tibex:inputBindings>
                    <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;FailLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>FailLog&lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.generalactivities.log" version="6.0.0.001"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                <value controlBy="Application" role="Info" suppressJobInfo="true"
                                    xsi:type="generalactivities:Log"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
        <bpws:throw faultName="tns:CheckFault" name="FailThrow">
            <bpws:targets>
                <bpws:target linkName="FailLogToFailThrow"/>
            </bpws:targets>
        </bpws:throw>
        <bpws:empty name="Join">
            <bpws:targets>
                <bpws:target linkName="OkDoneToJoin"/>
                <bpws:target linkName="AltLogToJoin"/>
            </bpws:targets>
            <bpws:sources>
                <bpws:source linkName="JoinToRisky"/>
            </bpws:sources>
        </bpws:empty>
        <bpws:extensionActivity>
            <tibex:activityExtension inputVariable="Risky-input" name="Risky"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
            <bpws:targets>
                <bpws:target linkName="JoinToRisky"/>
            </bpws:targets>
            <bpws:sources>
                <bpws:source linkName="RiskyToRecover" tibex:faultDetailsVar="RiskyFault" tibex:faultNameVar="FaultName">
                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##error##]]></bpws:transitionCondition>
                </bpws:source>
                <bpws:source linkName="RiskyToEnd"/>
            </bpws:sources>
                <tibex:inputBindings>
                    <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Risky-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>Risky&lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.generalactivities.log" version="6.0.0.001"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                <value controlBy="Application" role="Info" suppressJobInfo="true"
                                    xsi:type="generalactivities:Log"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
        <bpws:throw faultName="tns:RiskyFault" name="Recover">
            <bpws:targets>
                <bpws:target linkName="RiskyToRecover"/>
            </bpws:targets>
        </bpws:throw>
        <bpws:extensionActivity>
            <tibex:activityExtension inputVariable="End-input" name="End"
                xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
            <bpws:targets>
                <bpws:target linkName="RiskyToEnd"/>
            </bpws:targets>
                <tibex:inputBindings>
                    <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>End&lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                        expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <tibex:config>
                    <bwext:BWActivity activityTypeID="bw.generalactivities.log" version="6.0.0.001"
                        xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                        xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                        xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <activityConfig>
                            <properties name="config" xsi:type="activityconfig:EMFProperty">
                                <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                <value controlBy="Application" role="Info" suppressJobInfo="true"
                                    xsi:type="generalactivities:Log"/>
                            </properties>
                        </activityConfig>
                    </bwext:BWActivity>
                </tibex:config>
            </tibex:activityExtension>
        </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
