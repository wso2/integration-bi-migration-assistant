<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/pe/WriteToLogActivitySchema"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <pd:name>Processes/Reader.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:returnBindings/>
    <pd:endName>End</pd:endName>
    <pd:errorSchemas/>
    <pd:targetNamespace>http://xmlns.example.com/1357991310278</pd:targetNamespace>
    <pd:group name="For Each">
        <pd:type>com.tibco.pe.core.LoopGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>inputLoop</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:over>$Start/items/item</pd:over>
            <pd:iterationElementSlot>item</pd:iterationElementSlot>
            <pd:indexSlot>idx</pd:indexSlot>
            <pd:activityOutputName/>
            <pd:accumulateOutput>false</pd:accumulateOutput>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Read Counter</pd:to>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Read Counter</pd:from>
            <pd:to>end</pd:to>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:group name="Read Counter">
            <pd:type>com.tibco.pe.core.CriticalSectionGroup</pd:type>
            <pd:resourceType>ae.process.group</pd:resourceType>
            <pd:groupVariables/>
            <pd:joinToggle>inherit</pd:joinToggle>
            <config>
                <pd:groupType>criticalSection</pd:groupType>
                <pd:serializable>false</pd:serializable>
                <pd:scope>multiple</pd:scope>
                <pd:criticalSectionLock>/Resources/Locks/Counter.sharedLock</pd:criticalSectionLock>
            </config>
            <pd:inputBindings/>
            <pd:expanded>true</pd:expanded>
            <pd:transition>
                <pd:from>start</pd:from>
                <pd:to>Log Read</pd:to>
                <pd:conditionType>always</pd:conditionType>
            </pd:transition>
            <pd:transition>
                <pd:from>Log Read</pd:from>
                <pd:to>end</pd:to>
                <pd:conditionType>always</pd:conditionType>
            </pd:transition>
            <pd:activity name="Log Read">
                <pd:type>com.tibco.pe.core.WriteToLogActivity</pd:type>
                <pd:resourceType>ae.activities.log</pd:resourceType>
                <config>
                    <role>User</role>
                </config>
                <pd:inputBindings>
                    <ns:ActivityInput>
                        <message>
                            <xsl:value-of select="'reading counter'"/>
                        </message>
                    </ns:ActivityInput>
                </pd:inputBindings>
            </pd:activity>
        </pd:group>
    </pd:group>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>For Each</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>For Each</pd:from>
        <pd:to>Reset Counter</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:group name="Reset Counter">
        <pd:type>com.tibco.pe.core.CriticalSectionGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>criticalSection</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:scope> Multiple </pd:scope>
            <pd:criticalSectionLock>Resources\Locks\Counter.sharedLock</pd:criticalSectionLock>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Log Reset</pd:to>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Log Reset</pd:from>
            <pd:to>end</pd:to>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:activity name="Log Reset">
            <pd:type>com.tibco.pe.core.WriteToLogActivity</pd:type>
            <pd:resourceType>ae.activities.log</pd:resourceType>
            <config>
                <role>User</role>
            </config>
            <pd:inputBindings>
                <ns:ActivityInput>
                    <message>
                        <xsl:value-of select="'resetting counter'"/>
                    </message>
                </ns:ActivityInput>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
    <pd:group name="Unscoped">
        <pd:type>com.tibco.pe.core.CriticalSectionGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>criticalSection</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:criticalSectionLock>/Resources/Locks/Counter.sharedLock</pd:criticalSectionLock>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Log Unscoped</pd:to>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Log Unscoped</pd:from>
            <pd:to>end</pd:to>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:activity name="Log Unscoped">
            <pd:type>com.tibco.pe.core.WriteToLogActivity</pd:type>
            <pd:resourceType>ae.activities.log</pd:resourceType>
            <config>
                <role>User</role>
            </config>
            <pd:inputBindings>
                <ns:ActivityInput>
                    <message>
                        <xsl:value-of select="'no scope'"/>
                    </message>
                </ns:ActivityInput>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
    <pd:transition>
        <pd:from>Reset Counter</pd:from>
        <pd:to>Unscoped</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Unscoped</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>
