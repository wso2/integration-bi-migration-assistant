<?xml version="1.0" encoding="UTF-8"?>
<jndi:namedResource xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:http="http://xsd.tns.tibco.com/bw/models/sharedresource/httpclient" xmlns:jndi="http://xsd.tns.tibco.com/amf/models/sharedresource/jndi" xmi:id="_notifyHttpResource" name="Notify.HttpClientResource" type="http:HttpClientConfiguration">
  <jndi:configuration xsi:type="http:HttpClientConfiguration" xmi:id="_notifyHttpConfiguration" useSSL="true" httpClientVersion="httpcomponents">
    <substitutionBindings xmi:id="_notifyRetry" template="retryCount" propName="/Resources/Notify/HttpClient/RetryCount"/>
    <substitutionBindings xmi:id="_notifyIdle" template="idleConnectionTimeout" propName="/Resources/Notify/HttpClient/IdleTimeout"/>
    <tcpDetails xmi:id="_notifyTcpDetails">
      <substitutionBindings xmi:id="_notifyHost" template="host" propName="/Resources/Notify/HttpClient/Host"/>
      <substitutionBindings xmi:id="_notifyPort" template="port" propName="/Resources/Notify/HttpClient/Port"/>
      <substitutionBindings xmi:id="_notifySoTimeout" template="soTimeout" propName="/Resources/Notify/HttpClient/SocketTimeout"/>
    </tcpDetails>
  </jndi:configuration>
</jndi:namedResource>
