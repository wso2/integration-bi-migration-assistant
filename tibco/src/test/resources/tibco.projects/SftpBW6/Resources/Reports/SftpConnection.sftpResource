<?xml version="1.0" encoding="UTF-8"?>
<jndi:namedResource xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:jndi="http://xsd.tns.tibco.com/amf/models/sharedresource/jndi" xmlns:sftpconnection="http://ns.tibco.com/bw/palette/sftpconnection" xmi:id="_reportsResource" name="Reports.SftpConnection" type="sftpconnection:sftpconnection">
  <jndi:configuration xsi:type="sftpconnection:SFTPConnection" xmi:id="_reportsConfiguration" host="sftp.reports.example.com" privKeyAuth="true">
    <substitutionBindings xmi:id="_reportsuserName" template="userName" propName="/Resources/SFTP/Username"/>
    <substitutionBindings xmi:id="_reportsprivKey" template="privKey" propName="/Resources/SFTP/Reports/PrivateKey"/>
    <substitutionBindings xmi:id="_reportsprivKeypassword" template="privKeypassword" propName="/Resources/SFTP/Reports/PrivateKeyPassword"/>
  </jndi:configuration>
</jndi:namedResource>
